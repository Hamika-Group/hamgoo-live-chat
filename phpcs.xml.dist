<?xml version="1.0"?>
<ruleset name="Hamgoo Live Chat">
  <description>WordPress security/style checks and PHP 7.4+ compatibility.</description>
  <file>hamgoo-live-chat.php</file>
  <file>includes</file>
  <file>uninstall.php</file>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <config name="minimum_wp_version" value="6.5"/>
  <config name="testVersion" value="7.4-"/>
  <rule ref="WordPress-Core"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="PHPCompatibilityWP"/>
  <rule ref="WordPress.WP.I18n">
    <properties><property name="text_domain" type="array"><element value="hamgoo-live-chat"/></property></properties>
  </rule>
  <rule ref="Generic.Files.LineLength"><exclude-pattern>*</exclude-pattern></rule>
  <rule ref="Squiz.Commenting"><exclude-pattern>*</exclude-pattern></rule>
  <rule ref="PEAR.NamingConventions.ValidClassName"><exclude-pattern>*</exclude-pattern></rule>
</ruleset>
